# Browser copilot API base (no trailing slash). Paths: /v1/copilot/health, /v1/copilot/analyze (SSE).
#
# Local / dev: leave empty — fetches stay same-origin and Next rewrites to COPILOT_UPSTREAM_URL.
# Production (Vercel): set to the public Render HTTPS origin, e.g.
#   NEXT_PUBLIC_COPILOT_URL=https://your-copilot.onrender.com
#
# Never put LLM_API_KEY or other secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_COPILOT_URL=

# Server-side only (Next rewrite target when NEXT_PUBLIC_COPILOT_URL is empty). Not used on Vercel prod.
COPILOT_UPSTREAM_URL=http://127.0.0.1:8000
