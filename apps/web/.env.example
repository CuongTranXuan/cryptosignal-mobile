# --- Browser (optional direct mode) ---
# When set, the client calls this origin for /v1/copilot/* (no same-origin proxy).
# Origin only — no trailing slash, no /v1 suffix.
# NEXT_PUBLIC_COPILOT_URL=

# --- Server (same-origin proxy at /v1/copilot/*) ---
# Required at runtime when NEXT_PUBLIC_COPILOT_URL is unset/empty.
# COPILOT_UPSTREAM_URL=http://127.0.0.1:8000

# --- Container / platform ---
# PORT=3000
# HOSTNAME=0.0.0.0

# --- Dev only (optional) ---
# NEXT_PUBLIC_COPILOT_MOCK=1
