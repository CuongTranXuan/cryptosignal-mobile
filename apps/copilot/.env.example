LLM_API_STYLE=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=agentrouter/deepseek-v4-flash
LLM_TIMEOUT_S=180
# Default analyze candle count when the client omits candle_count
COPILOT_DEFAULT_CANDLE_COUNT=100
# Optional: comma-separated model ids or prefixes (see model_availability.py)
# COPILOT_MODEL_ALLOWLIST=agentrouter/deepseek-v4-flash
# COPILOT_MODEL_PREFIXES=agentrouter/
# COPILOT_MODELS_CACHE_TTL_S=600
# COPILOT_SESSIONS_DB=
# Comma-separated frontend origins for prod (Vercel URL). Local defaults apply if unset.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional; default 10. Applies to POST /v1/copilot/analyze only.
RATE_LIMIT_PER_MINUTE=10
