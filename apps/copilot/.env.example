LLM_API_STYLE=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=180
# Comma-separated frontend origins for prod (Vercel URL). Local defaults apply if unset.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional; default 10. Applies to POST /v1/copilot/analyze only.
RATE_LIMIT_PER_MINUTE=10
