# Generic OpenAI-compatible LLM (required for analyze; health returns 503 until set)
LLM_API_STYLE=openai
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=your-provider/your-model
LLM_TIMEOUT_S=180

# Sessions database (SQLAlchemy + Alembic). Legacy: COPILOT_SESSIONS_DB path → sqlite URL.
# DATABASE_URL=sqlite:////var/lib/cryptosignal/copilot/sessions.sqlite3
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/copilot
# DATABASE_URL=sqlite+libsql://user:token@host/dbname?secure=true
# COPILOT_SESSIONS_DB=/path/to/sessions.sqlite3
# COPILOT_DATA_DIR=/var/lib/cryptosignal/copilot
COPILOT_RUN_DB_MIGRATIONS=false

# Optional model catalog filters (empty / unset = no filter)
# COPILOT_MODEL_PROVIDERS=agentrouter,cursor
# COPILOT_MODEL_VISIBILITY_ALLOWLIST=model-a,model-b
# COPILOT_MODEL_ID_PREFIX_ALIASES=cu/:cursor/
# COPILOT_MODEL_OVERRIDES_FILE=./config/omniroute.model-overrides.json.example
# COPILOT_MODEL_OVERRIDES_JSON={"models":{"vendor/*":{"request_max_tokens":8192}}}
# COPILOT_MODEL_ADVANCED_SUBSTRINGS=/no-think/,/auto/
# COPILOT_MODEL_INCLUDE_COMBO=false
# COPILOT_MODEL_NEGATIVE_CACHE_TTL_S=300
# COPILOT_MODELS_CACHE_TTL_S=600

COPILOT_DEFAULT_CANDLE_COUNT=100

# CORS when the browser calls copilot directly (not needed behind the Next.js proxy or nginx).
# Unset = dev default (localhost/127.0.0.1 on :3100 and :3000); production default = none.
# CORS_ORIGINS=https://your-domain.example
RATE_LIMIT_PER_MINUTE=10

# VPS: production mode (no /tmp DB, strict CORS) and nginx on loopback as the only trusted proxy.
# COPILOT_ENV=production
# COPILOT_DATA_DIR=/var/lib/cryptosignal
# COPILOT_TRUSTED_PROXIES=127.0.0.1
# AUTOSCAN_ENABLED=false
# Device ownership cookie key (required in production, >= 32 chars; dev generates one).
# COPILOT_DEVICE_SECRET=
# Dev only: serve cookie-less requests unscoped while the web proxy drops Cookie.
# COPILOT_DEVICE_COOKIE_OPTIONAL=1
# Full feedback export (Authorization: Bearer <token>); unset = disabled. >= 32 chars in production.
# COPILOT_ADMIN_TOKEN=

# OmniRoute example: see config/omniroute.env.example

# Google Gemini (OpenAI-compatible): see config/gemini.env.example
# LLM_API_STYLE=openai
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-2.5-flash
