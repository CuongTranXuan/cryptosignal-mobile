# Google Gemini via OpenAI-compatible endpoint (https://ai.google.dev/gemini-api/docs/openai)
LLM_API_STYLE=openai
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=180

# Optional catalog tuning (same as other providers)
# COPILOT_MODEL_VISIBILITY_ALLOWLIST=gemini-2.5-flash,gemini-2.5-pro
# COPILOT_DEFAULT_MODEL_CONTEXT=1048576
# COPILOT_DEFAULT_MODEL_MAX_OUTPUT=65536
