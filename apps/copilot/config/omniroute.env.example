# Example: OmniRoute (OpenAI-compatible gateway). Copy values into your real .env — never commit secrets.

LLM_API_STYLE=openai
LLM_BASE_URL=https://your-omniroute-host/v1
LLM_API_KEY=
LLM_MODEL=agentrouter/deepseek-v4-flash
LLM_TIMEOUT_S=180

DATABASE_URL=sqlite:////var/lib/cryptosignal/copilot/sessions.sqlite3
COPILOT_RUN_DB_MIGRATIONS=true

COPILOT_MODEL_PROVIDERS=agentrouter,cursor
COPILOT_MODEL_VISIBILITY_ALLOWLIST=agentrouter/deepseek-v4-flash,cursor/auto,cursor/auto-balance,cursor/auto-cost,cursor/auto-intelligence,cursor/composer-2.5,cursor/composer-2.5-fast
COPILOT_MODEL_ID_PREFIX_ALIASES=cu/:cursor/
COPILOT_MODEL_OVERRIDES_FILE=./config/omniroute.model-overrides.json.example

CORS_ORIGINS=https://your-frontend.example
