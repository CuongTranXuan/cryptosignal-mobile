# Copy to deploy/.env and fill secrets. Do not commit .env.

PORT=8000

LLM_API_STYLE=openai
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=your-provider/your-model
LLM_TIMEOUT_S=180

# SQLite on the copilot container (omit postgres profile):
# DATABASE_URL=sqlite:////tmp/copilot-sessions.sqlite3

# With `docker compose --profile postgres up`:
DATABASE_URL=postgresql+psycopg://copilot:copilot@postgres:5432/copilot

COPILOT_RUN_DB_MIGRATIONS=true
# Optional when using compose web proxy only (browser → web → copilot):
# CORS_ORIGINS=

# Compose publish ports (optional)
# WEB_PUBLISH_PORT=3000
# COPILOT_PUBLISH_PORT=8000  # only with docker-compose.expose-copilot.yml
