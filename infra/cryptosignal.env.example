# Local Docker defaults. Copy to the repo root as `.env`:
#   cp infra/cryptosignal.env.example .env
# Or run `pnpm docker:up`, which creates `.env` from `.env.example`.

DATABASE_URL=postgresql://cryptosignal:cryptosignal@postgres:5432/cryptosignal
POSTGRES_PASSWORD=cryptosignal

DASHBOARD_BOOTSTRAP_TOKEN=local-dev-bootstrap-token-at-least-32-chars
SIGNAL_INGEST_TOKEN=local-dev-ingest-token-secret-value

# Optional. Required only with --with-telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Optional market-data profiles (--with-market-live / --with-market-retain).
MARKET_REDIS_URL=redis://redis:6379/0
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=cryptosignal
CLICKHOUSE_PASSWORD=local-clickhouse-password
SEAWEEDFS_S3_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_S3_BUCKET=cryptosignal-market-archive
SEAWEEDFS_S3_ACCESS_KEY=local-seaweedfs-access-key
SEAWEEDFS_S3_SECRET_KEY=local-seaweedfs-secret-key
MARKET_SPOOL_DIR=/var/lib/cryptosignal/market-spool
MARKET_WRITER_INTERVAL_MS=1000

# Optional MCP research adapter (--with-mcp-research). Public read-only tools only.
BINANCE_MCP_ENABLED=false
BINANCE_MCP_PUBLIC_TOOL_IDS=
