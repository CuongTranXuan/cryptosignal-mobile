# Copy this file outside the repository (for example /etc/cryptosignal/production.env),
# replace every placeholder, and restrict it with chmod 600.
DATABASE_URL=mysql://user:password@database-host:3306/cryptosignal
DASHBOARD_BOOTSTRAP_TOKEN=replace-with-a-random-32-character-or-longer-secret
SIGNAL_INGEST_TOKEN=replace-with-a-separate-random-secret

# Optional. Required only when starting the telegram profile.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Self-hosted public market-data services. These are local deployment credentials,
# not Binance credentials, and no exchange account access is configured.
MARKET_REDIS_URL=redis://redis:6379/0
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=cryptosignal
CLICKHOUSE_PASSWORD=replace-before-production
SEAWEEDFS_S3_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_S3_BUCKET=cryptosignal-market-archive
SEAWEEDFS_S3_ACCESS_KEY=replace-before-production
SEAWEEDFS_S3_SECRET_KEY=replace-before-production
MARKET_SPOOL_DIR=/var/lib/cryptosignal/market-spool
MARKET_WRITER_INTERVAL_MS=1000
